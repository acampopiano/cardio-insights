              "native": "SELECT\n  DATE_FORMAT(f.FechaRealizado, '%Y') AS Periodo, \n  COUNT(*) AS Total\nFROM sqlflow_coordina f\nWHERE f.`Realizado` = 255 AND f.CodCoordinaReglaMotivo IN (117, 128) AND DATE_FORMAT(f.FechaRealizado, '%Y') > 2004 AND DATE_FORMAT(f.FechaRealizado, '%Y') < 2026\n\n      [[AND (({{sede}} = 'SMI' AND COALESCE(f.Hbritanico, 0) = 0) OR ({{sede}} = 'Britanico' AND f.Hbritanico = 1))]]\n      [[AND (({{facturacion}} = 'FNR' AND f.CodDestinoFact = 3) OR ({{facturacion}} = 'Otro' AND COALESCE(f.CodDestinoFact, 0) <> 3))]]\nGROUP BY Periodo\nORDER BY Periodo;",
