        "query_type": "native",
        "download_perms": "full",
        "name": "Observaciones más comunes (Top 10)",
        "document_id": null,
        "last_used_at": "2026-07-28T17:30:01.220531Z",
        "type": "question",
        "dimensions": null,
        "query_average_duration": 384,
        "creator_id": 13371339,
        "moderation_reviews": [],
        "updated_at": "2026-07-28T19:27:36.175395Z",
        "made_public_by_id": null,
        "embedding_params": null,
        "cache_ttl": null,
        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 2,
          "stages": [
            {
              "lib/type": "mbql.stage/native",
              "native": "SELECT \n    o.Descr AS Observacion,\n    COUNT(*) AS Total,\n    ROUND(COUNT(*) * 100.0 / t.TotalGeneral, 2) AS Porcentaje\nFROM (\n    SELECT CodObs1 AS CodObs FROM flow_procedimientocardiologiablockdetalle WHERE CodObs1 IS NOT NULL\n    UNION ALL\n    SELECT CodObs2 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs2 IS NOT NULL\n    UNION ALL\n    SELECT CodObs3 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs3 IS NOT NULL\n    UNION ALL\n    SELECT CodObs4 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs4 IS NOT NULL\n    UNION ALL\n    SELECT CodObs5 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs5 IS NOT NULL\n    UNION ALL\n    SELECT CodObs6 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs6 IS NOT NULL\n    UNION ALL\n    SELECT CodObs7 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs7 IS NOT NULL\n    UNION ALL\n    SELECT CodObs8 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs8 IS NOT NULL\n) obs\nINNER JOIN med_blockobservacion o \n    ON obs.CodObs = o.k_id\nJOIN (\n    SELECT COUNT(*) AS TotalGeneral\n    FROM (\n        SELECT CodObs1 AS CodObs FROM flow_procedimientocardiologiablockdetalle WHERE CodObs1 IS NOT NULL\n        UNION ALL\n        SELECT CodObs2 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs2 IS NOT NULL\n        UNION ALL\n        SELECT CodObs3 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs3 IS NOT NULL\n        UNION ALL\n        SELECT CodObs4 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs4 IS NOT NULL\n        UNION ALL\n        SELECT CodObs5 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs5 IS NOT NULL\n        UNION ALL\n        SELECT CodObs6 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs6 IS NOT NULL\n        UNION ALL\n        SELECT CodObs7 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs7 IS NOT NULL\n        UNION ALL\n        SELECT CodObs8 FROM flow_procedimientocardiologiablockdetalle WHERE CodObs8 IS NOT NULL\n    ) all_obs\n) t\nWHERE o.Descr IS NOT NULL   -- 🔑 evita que aparezcan observaciones sin descripción\nGROUP BY o.Descr, t.TotalGeneral\nORDER BY Total DESC\nLIMIT 10;\n"
            }
          ]
        },
