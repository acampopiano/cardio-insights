        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 2,
          "stages": [
            {
              "native": "SELECT\n  DATE_FORMAT(f.FechaRealizado, '%Y-%m') AS periodo, f.`sTecnicaDetalle` as tipo_acto,\n  COUNT(*) AS total\nFROM sqlflow_coordina f\nWHERE f.`Realizado` = 255 AND DATE_FORMAT(f.FechaRealizado, '%Y') = {{anio}} AND f.CodCoordinaReglaMotivo IN (112, 113, 117, 128)\n\n      [[AND (({{sede}} = 'SMI' AND COALESCE(f.Hbritanico, 0) = 0) OR ({{sede}} = 'Britanico' AND f.Hbritanico = 1))]]\n      [[AND (({{facturacion}} = 'FNR' AND f.CodDestinoFact = 3) OR ({{facturacion}} = 'Otro' AND COALESCE(f.CodDestinoFact, 0) <> 3))]]\nGROUP BY periodo, tipo_acto\nORDER BY periodo, tipo_acto;",
              "lib/type": "mbql.stage/native",
