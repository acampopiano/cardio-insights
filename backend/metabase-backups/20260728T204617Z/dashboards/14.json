NION ALL\n        SELECT CodProc8 FROM flow_procedimientocardiologiablockdetalle WHERE CodProc8 IS NOT NULL\n    ) all_proc\n) t\nWHERE p.Descr IS NOT NULL   -- 🔑 evita que aparezca (NULL) en el resultado\nGROUP BY p.Descr, t.TotalGeneral\nORDER BY Total DESC\nLIMIT 10;\n"
