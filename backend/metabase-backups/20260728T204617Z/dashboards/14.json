        "embedding_params": null,
        "cache_ttl": null,
        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 2,
          "stages": [
            {
              "lib/type": "mbql.stage/native",
              "native": "SELECT \n    d.Descr AS Diagnostico,\n    COUNT(*) AS Total,\n    ROUND(COUNT(*) * 100.0 / t.TotalGeneral, 2) AS Porcentaje\nFROM (\n    SELECT CodDiagno1 AS CodDiagno FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno1 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno2 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno2 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno3 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno3 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno4 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno4 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno5 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno5 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno6 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno6 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno7 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno7 IS NOT NULL\n    UNION ALL\n    SELECT CodDiagno8 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno8 IS NOT NULL\n) diag\nINNER JOIN med_blockdiagnosticotree d \n    ON diag.CodDiagno = d.k_id\nJOIN (\n    SELECT COUNT(*) AS TotalGeneral\n    FROM (\n        SELECT CodDiagno1 AS CodDiagno FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno1 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno2 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno2 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno3 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno3 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno4 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno4 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno5 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno5 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno6 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno6 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno7 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno7 IS NOT NULL\n        UNION ALL\n        SELECT CodDiagno8 FROM flow_procedimientocardiologiablockdetalle WHERE CodDiagno8 IS NOT NULL\n    ) all_diag\n) t\nWHERE d.Descr IS NOT NULL   -- 🔑 evita que aparezca (NULL) en el resultado\nGROUP BY d.Descr, t.TotalGeneral\nORDER BY Total DESC\nLIMIT 10;"
            }
          ]
        },
