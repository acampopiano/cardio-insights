        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 2,
          "stages": [
            {
              "native": "SELECT\n  DATE_FORMAT(f.FechaRealizado, '%Y') AS Periodo, \n  m.descr AS Tipo,\n  COUNT(*) AS Total\nFROM sqlflow_coordina f\nInner join med_tecnicadetalle m on m.Cod = f.CodCoordinaReglaMotivo\nWHERE f.`Realizado` = 255 AND f.CodCoordinaReglaMotivo IN (124, 125, 126, 127, 228) AND DATE_FORMAT(f.FechaRealizado, '%Y') > 2004\n\n      [[AND (({{sede}} = 'SMI' AND COALESCE(f.Hbritanico, 0) = 0) OR ({{sede}} = 'Britanico' AND f.Hbritanico = 1))]]\n      [[AND (({{facturacion}} = 'FNR' AND f.CodDestinoFact = 3) OR ({{facturacion}} = 'Otro' AND COALESCE(f.CodDestinoFact, 0) <> 3))]]\nGROUP BY Tipo, Periodo\nORDER BY periodo;",
              "lib/type": "mbql.stage/native",
              "template-tags": {
                "sede": {
                  "type": "text",
                  "id": "1bcfeaaf-9a0d-4be8-a2bb-062b060afa0e",
