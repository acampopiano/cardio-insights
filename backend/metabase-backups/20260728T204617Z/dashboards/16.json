        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 2,
          "stages": [
            {
              "native": "SELECT\n  DATE_FORMAT(f.FechaRealizado, '%Y') AS Periodo, \n  COUNT(*) AS Total\nFROM sqlflow_coordina f\nINNER JOIN med_tecnicadetalle mt ON mt.Cod = f.CodCoordinaReglaMotivo AND mt.Estructural = 1\nWHERE f.`Realizado` = 255 AND DATE_FORMAT(f.FechaRealizado, '%Y') > 2004 AND DATE_FORMAT(f.FechaRealizado, '%Y') < 2026\n\n      [[AND (({{sede}} = 'SMI' AND COALESCE(f.Hbritanico, 0) = 0) OR ({{sede}} = 'Britanico' AND f.Hbritanico = 1))]]\n      [[AND (({{facturacion}} = 'FNR' AND f.CodDestinoFact = 3) OR ({{facturacion}} = 'Otro' AND COALESCE(f.CodDestinoFact, 0) <> 3))]]\nGROUP BY Periodo\nORDER BY Periodo;",
              "lib/type": "mbql.stage/native",
              "template-tags": {
                "sede": {
                  "display-name": "Sede",
                  "type": "text",
                  "id": "e0e73021-6872-4d7a-8eb3-ef90cb21a8e6",
